{
  "expo": {
    "name": "PULSE",
    "slug": "pulse-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.net.ssh.pulse"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030712"
      },
      "package": "in.net.ssh.pulse",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow PULSE to access microphone for voice medication logging and SOS emergency recordings."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PULSE to access photos to upload prescriptions and lab reports.",
          "cameraPermission": "Allow PULSE to take photos of prescriptions."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PULSE to find nearby hospitals, clinics, and pharmacies."
        }
      ]
    ]
  }
}
